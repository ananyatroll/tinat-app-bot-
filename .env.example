BOT_TOKEN=replace_with_your_telegram_bot_token
ADMIN_CHAT_ID=123456789
# Telegram numeric user ID of the support person who assigns vouchers.
# If left empty, the admin also acts as support.
SUPPORT_CHAT_ID=
PACKAGES_JSON=[{"key":"euee-preo","label":"EUEE Preo","priceCents":25000,"currency":"ETB","phrasePool":"euee-preo"},{"key":"freshman","label":"Freshman","priceCents":25000,"currency":"ETB","phrasePool":"freshman"},{"key":"uat","label":"UAT","priceCents":25000,"currency":"ETB","phrasePool":"uat"},{"key":"university-department","label":"University Department","priceCents":25000,"currency":"ETB","phrasePool":"university-department"},{"key":"exit-exam","label":"Exit Exam","priceCents":25000,"currency":"ETB","phrasePool":"exit-exam"}]
PHRASES_DIR=./phrases
VOUCHERS_FILE=./data/vouchers.json
USERS_FILE=./data/users.json
ENTITLEMENTS_FILE=./data/entitlements.json
# Port for the local redemption API
REDEEM_API_PORT=8787
# Anti-guessing limits on the redeem endpoint (per user and per IP)
REDEEM_RATE_LIMIT_MAX=5
REDEEM_RATE_LIMIT_WINDOW_MS=600000
