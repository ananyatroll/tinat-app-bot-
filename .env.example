BOT_TOKEN=replace_with_your_telegram_bot_token
ADMIN_CHAT_ID=123456789
# Telegram numeric user ID of the support person who assigns vouchers.
# If left empty, the admin also acts as support.
SUPPORT_CHAT_ID=
PACKAGES_JSON=[{"key":"euee-preo","label":"EUEE Preo","priceCents":30000,"currency":"ETB","phrasePool":"euee-preo"},{"key":"freshman","label":"Freshman","priceCents":30000,"currency":"ETB","phrasePool":"freshman"},{"key":"uat","label":"UAT","priceCents":30000,"currency":"ETB","phrasePool":"uat"},{"key":"university-department","label":"University Department","priceCents":30000,"currency":"ETB","phrasePool":"university-department"},{"key":"exit-exam","label":"Exit Exam","priceCents":30000,"currency":"ETB","phrasePool":"exit-exam"}]
PHRASES_DIR=./phrases
# Where all state JSON files live (vouchers, users, entitlements, tokens).
# Default: ./data relative to the repo. On Railway point this at the mounted
# persistent volume, e.g. /data. The app refuses to start if an explicitly
# configured DATA_DIR is missing (that means the volume is not mounted).
DATA_DIR=./data
# Optional per-file overrides, all defaulting to <DATA_DIR>/<name>.json.
# Normally not needed; use DATA_DIR instead.
#VOUCHERS_FILE=./data/vouchers.json
#USERS_FILE=./data/users.json
#ENTITLEMENTS_FILE=./data/entitlements.json
#PROCESSED_UPDATES_FILE=./data/processed_updates.json
# Port for the local redemption API
REDEEM_API_PORT=8787
# Anti-guessing limits on the redeem endpoint (per user and per IP)
REDEEM_RATE_LIMIT_MAX=5
REDEEM_RATE_LIMIT_WINDOW_MS=600000
# Android activation limits (per phone, per code, per IP). Defaults to the
# redeem limits above.
ANDROID_RATE_LIMIT_MAX=5
ANDROID_RATE_LIMIT_WINDOW_MS=600000
# App access tokens issued after Android activation (default: 1 year)
#ACCESS_TOKENS_FILE=./data/access_tokens.json
ACCESS_TOKEN_TTL_SECONDS=31536000
# Telegram Mini App / login-widget auth token lifetime
AUTH_TOKEN_TTL_SECONDS=86400
